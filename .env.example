# Model provider (required for Agent chat)
ANTHROPIC_API_KEY=

# Optional Anthropic-compatible endpoint (e.g. Volcengine Ark / DeepSeek)
# Use the gateway root; the agent automatically appends /v1 for /messages.
# ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# MODEL_ID=deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-flash

# Optional: use AWS Bedrock instead of Anthropic API
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2


# Services
POD_SERVER_URL=http://localhost:7000
POD_SERVER_PUBLIC_URL=http://localhost:7000
WEB_PORT=3000
POD_SERVER_PORT=7000
AGENT_PORT=4000
PREVIEW_PORT=8000

# Control plane and in-progress chat resume. Leave unset to keep the JSON
# registry and today's SSE (no resume).
# DATABASE_URL=postgresql://sandbox:sandbox@127.0.0.1:5432/agent_sandbox
# REDIS_URL=redis://127.0.0.1:6379

# Docker agent image used by pod-server
AGENT_IMAGE=agent-sandbox-agent:latest

# Host directory for project volumes (defaults to apps/pod-server/data)
# POD_DATA_DIR=
